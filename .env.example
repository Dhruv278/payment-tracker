# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy anon key
SUPABASE_SECRET_KEY=sb_secret_xxx                         # or the legacy service_role key — server only!

# Public URL of the app (used in email links). http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your name/business as clients see it (login page, portal header, emails)
NEXT_PUBLIC_BRAND_NAME=Your Name
NEXT_PUBLIC_BRAND_TAGLINE=Freelance software developer

# Comma-separated emails that get the developer (admin) role on sign-in.
DEVELOPER_EMAILS=you@example.com

# Gmail SMTP for app notifications (Google Account → Security → App passwords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM_NAME=Payment Tracker

# Optional: any SMTP server instead of Gmail. For local dev with `supabase start`,
# emails go to the Mailpit inbox at http://127.0.0.1:54324
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325
# EMAIL_FROM=no-reply@payment-tracker.local
